{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ogrpwkozurjxziwvycjp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "pixel-perfect-clone",
      "version": "0.1.0",
      "title": "Pixel-Perfect Clone"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List the Ágata projects you own or that belong to your workspaces.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_project",
        "title": "Get project",
        "description": "Read one project's purpose, guide, MCP and skill links and listed models.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid",
              "description": "Project id from list_projects."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_project",
        "title": "Update project",
        "description": "Update a project's purpose and/or guide. Only owners and workspace admins can edit.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "purpose": {
              "type": "string",
              "maxLength": 600,
              "description": "New purpose text."
            },
            "guide": {
              "type": "string",
              "maxLength": 20000,
              "description": "New guide (Markdown)."
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_notes",
        "title": "List vault notes",
        "description": "List the Obsidian-style Markdown notes in a project's vault.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "read_note",
        "title": "Read note",
        "description": "Read a Markdown note from a project's vault.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\.md$",
              "description": "Vault-relative Markdown path, e.g. 'Systems/Combat.md'."
            }
          },
          "required": [
            "project_id",
            "path"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "write_note",
        "title": "Write note",
        "description": "Create or replace a Markdown note in a project's vault. [[wikilinks]] are kept as-is.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\.md$",
              "description": "Vault-relative Markdown path, e.g. 'Systems/Combat.md'."
            },
            "content": {
              "type": "string",
              "maxLength": 200000
            }
          },
          "required": [
            "project_id",
            "path",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_note",
        "title": "Delete note",
        "description": "Delete a Markdown note from a project's vault.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\.md$",
              "description": "Vault-relative Markdown path, e.g. 'Systems/Combat.md'."
            }
          },
          "required": [
            "project_id",
            "path"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_skills",
        "title": "List skills",
        "description": "List a project's skills and the tool each one is built for (Claude Code, Codex or Gemini CLI).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "project_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_skill",
        "title": "Get skill",
        "description": "Get a skill's SKILL.md and the folder to install it in. Only install it into the tool it targets — it is not designed for other models.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "skill_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "skill_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
